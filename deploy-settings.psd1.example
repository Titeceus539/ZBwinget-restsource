@{
    # Example / template - placeholders only, no real IDs (that is the point of this file)
    TenantId                                 = '<your-tenant-guid>'
    SubscriptionId                           = '<your-subscription-guid>'
    Name                                     = 'YourWinget'
    ResourceGroup                            = 'your-winget-rg'
    Region                                   = 'australiaeast'
    TemplateFolderPath                       = $null
    ParameterOutputPath                      = 'Parameters'
    RestSourcePath                           = $null
    ImplementationPerformance                = 'Developer'
    RestSourceAuthentication                 = 'None'
    PublisherName                            = '<publisher>'
    PublisherEmail                           = '<email>'
    ShowConnectionInstructions               = $true
    MaxRetryCount                            = 5
    InformationAction                        = 'Continue'
    Verbose                                  = $true
}